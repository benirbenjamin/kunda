# ==========================================
# KUNDA SPACE ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173

# Database (PostgreSQL / Supabase)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kunda_space
PGSSLMODE=disable

# Authentication & Session Security
# Generate secure 64-character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=kunda-space-jwt-super-secret-key-change-this-in-production-64char-minimum
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=kunda-space-refresh-super-secret-key-change-this-in-production

# Flutterwave Payment Gateway (Sandbox & Live)
# Get credentials from Flutterwave Dashboard -> Settings -> API Keys & Webhooks
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
FLW_ENCRYPTION_KEY=FLWSECK_TEST_ENCR-xxxxxxxxxxxx
FLW_SECRET_HASH=kunda_space_flw_webhook_secret_hash_verify

# Web Push Notification (VAPID - RFC 8292 Compliant)
VAPID_PUBLIC_KEY=BBU1NzlIGBblUzcQM-SaMDPsGJjhyohTzcl6Vo0EmzahRMraY7SVl7YrVvwaoAQr0rLLmLd3393TT3ZXpWXiD_A
VAPID_PRIVATE_KEY=CHXPS8JASMl_jHYVRDZTqumWDKzkKATs86fEh3mQMTI
VAPID_SUBJECT=mailto:admin@kunda.space

# Admin Initial Credentials (Used during initial migration/seed)
ADMIN_INITIAL_EMAIL=admin@kunda.space
ADMIN_INITIAL_PASSWORD=ChangeMeNow123!

# Email Service Configuration (Configurable here or in Admin Portal Settings)
# Options for EMAIL_PROVIDER: 'resend', 'smtp', or 'mock'
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Kunda Space <onboarding@resend.dev>

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM_EMAIL=Kunda Space <noreply@kunda.space>

# Google Drive Storage Configuration (Refresh Token Method)
# Configure here or dynamically in Admin Portal Settings
GOOGLE_DRIVE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_DRIVE_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id-optional
