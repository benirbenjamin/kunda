// =====================================================================
// KUNDA SPACE: PRISMA SCHEMA FOR MYSQL (cPanel / Production Ready)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String       @id @default(uuid()) @db.VarChar(36)
  email             String       @unique @db.VarChar(255)
  passwordHash      String       @map("password_hash") @db.VarChar(255)
  role              String       @default("user") @db.VarChar(50)
  dob               DateTime     @db.Date
  phone             String?      @db.VarChar(50)
  phoneCode         String?      @map("phone_code") @db.VarChar(10)
  preferredLanguage String       @default("en") @map("preferred_language") @db.VarChar(10)
  emailVerified     Boolean      @default(false) @map("email_verified")
  phoneVerified     Boolean      @default(false) @map("phone_verified")
  isSuspended       Boolean      @default(false) @map("is_suspended")
  suspensionReason  String?      @map("suspension_reason") @db.Text
  termsAcceptedAt   DateTime?    @default(now()) @map("terms_accepted_at")
  privacyAcceptedAt DateTime?    @default(now()) @map("privacy_accepted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")

  profile                  Profile?
  sentLikes                Like[]                  @relation("SentLikes")
  receivedLikes            Like[]                  @relation("ReceivedLikes")
  sentPasses               Pass[]                  @relation("SentPasses")
  receivedPasses           Pass[]                  @relation("ReceivedPasses")
  matchesAsUser1           Match[]                 @relation("User1Matches")
  matchesAsUser2           Match[]                 @relation("User2Matches")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]               @relation("SentMessages")
  receivedMessages         Message[]               @relation("ReceivedMessages")
  allowance                MessageAllowance?
  wallet                   Wallet?
  walletTransactions       WalletTransaction[]
  subscriptions            Subscription[]
  paymentAttempts          PaymentAttempt[]
  requestedUnlocks         ContactUnlock[]         @relation("RequestedUnlocks")
  targetUnlocks            ContactUnlock[]         @relation("TargetUnlocks")
  notifications            Notification[]
  blockedUsers             Block[]                 @relation("BlockerUsers")
  blockedByUsers           Block[]                 @relation("BlockedUsers")
  filedReports             Report[]                @relation("ReporterReports")
  reportsAgainst           Report[]                @relation("ReportedReports")
  moderationEvents         ModerationEvent[]
  auditLogs                AuditLog[]

  @@map("users")
}

model Profile {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  userId                String    @unique @map("user_id") @db.VarChar(36)
  displayName           String    @map("display_name") @db.VarChar(100)
  gender                String    @db.VarChar(50)
  interestedIn          String    @map("interested_in") @db.VarChar(50)
  country               String    @default("Rwanda") @db.VarChar(100)
  city                  String    @default("Kigali") @db.VarChar(100)
  bio                   String?   @db.Text
  height                Int?
  languages             Json?
  education             String?   @db.VarChar(100)
  occupation            String?   @db.VarChar(100)
  relationshipIntention String    @default("serious_relationship") @map("relationship_intention") @db.VarChar(100)
  childrenStatus        String?   @map("children_status") @db.VarChar(100)
  lifestyleDrinking     String?   @map("lifestyle_drinking") @db.VarChar(50)
  lifestyleSmoking      String?   @map("lifestyle_smoking") @db.VarChar(50)
  contactSharingConsent Boolean   @default(false) @map("contact_sharing_consent")
  profileCompleted      Boolean   @default(false) @map("profile_completed")
  verifiedBadge         Boolean   @default(false) @map("verified_badge")
  photos                Json?
  interests             Json?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profilePhotos         ProfilePhoto[]
  preference            ProfilePreference?
  userInterests         UserInterest[]

  @@map("profiles")
}

model ProfilePhoto {
  id               String   @id @default(uuid()) @db.VarChar(36)
  profileId        String   @map("profile_id") @db.VarChar(36)
  photoUrl         String   @map("photo_url") @db.Text
  isPrimary        Boolean  @default(false) @map("is_primary")
  displayOrder     Int      @default(0) @map("display_order")
  moderationStatus String   @default("approved") @map("moderation_status") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

model ProfilePreference {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  profileId          String   @unique @map("profile_id") @db.VarChar(36)
  minAge             Int      @default(20) @map("min_age")
  maxAge             Int      @default(45) @map("max_age")
  preferredCountry   String   @default("Rwanda") @map("preferred_country") @db.VarChar(100)
  preferredCities    Json?    @map("preferred_cities")
  datingScope        String   @default("local") @map("dating_scope") @db.VarChar(50)
  appearanceSkinTone String?  @map("appearance_skin_tone") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_preferences")
}

model Interest {
  id       String         @id @default(uuid()) @db.VarChar(36)
  category String         @db.VarChar(50)
  nameEn   String         @unique @map("name_en") @db.VarChar(100)
  nameRw   String         @map("name_rw") @db.VarChar(100)
  nameFr   String         @map("name_fr") @db.VarChar(100)
  icon     String?        @db.VarChar(50)

  userInterests UserInterest[]

  @@map("interests")
}

model UserInterest {
  profileId  String @map("profile_id") @db.VarChar(36)
  interestId String @map("interest_id") @db.VarChar(36)

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@map("user_interests")
}

model Like {
  id          String   @id @default(uuid()) @db.VarChar(36)
  fromUserId  String   @map("from_user_id") @db.VarChar(36)
  toUserId    String   @map("to_user_id") @db.VarChar(36)
  isSuperLike Boolean  @default(false) @map("is_super_like")
  createdAt   DateTime @default(now()) @map("created_at")

  fromUser User @relation("SentLikes", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReceivedLikes", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId], name: "unique_user_like")
  @@map("likes")
}

model Pass {
  id         String   @id @default(uuid()) @db.VarChar(36)
  fromUserId String   @map("from_user_id") @db.VarChar(36)
  toUserId   String   @map("to_user_id") @db.VarChar(36)
  createdAt  DateTime @default(now()) @map("created_at")

  fromUser User @relation("SentPasses", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReceivedPasses", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId], name: "unique_user_pass")
  @@map("passes")
}

model Match {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  user1Id            String   @map("user1_id") @db.VarChar(36)
  user2Id            String   @map("user2_id") @db.VarChar(36)
  compatibilityScore Int      @default(85) @map("compatibility_score")
  createdAt          DateTime @default(now()) @map("created_at")

  user1 User @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id], name: "unique_match_pair")
  @@map("matches")
}

model Conversation {
  id        String   @id @default(uuid()) @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  lastReadAt     DateTime? @default(now()) @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid()) @db.VarChar(36)
  conversationId String    @map("conversation_id") @db.VarChar(36)
  senderId       String    @map("sender_id") @db.VarChar(36)
  recipientId    String    @map("recipient_id") @db.VarChar(36)
  content        String    @db.Text
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  isFlagged      Boolean   @default(false) @map("is_flagged")
  moderationNote String?   @map("moderation_note") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User         @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model MessageAllowance {
  id                          String   @id @default(uuid()) @db.VarChar(36)
  userId                      String   @unique @map("user_id") @db.VarChar(36)
  initialFreeRemaining        Int      @default(3) @map("initial_free_remaining")
  distinctRecipientsContacted Json?    @map("distinct_recipients_contacted")
  freeRepliesRemaining        Int      @default(3) @map("free_replies_remaining")
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("message_allowances")
}

model Wallet {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @unique @map("user_id") @db.VarChar(36)
  balanceMinor BigInt   @default(0) @map("balance_minor")
  currency     String   @default("RWF") @db.VarChar(10)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String   @id @default(uuid()) @db.VarChar(36)
  walletId       String   @map("wallet_id") @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @default("RWF") @db.VarChar(10)
  type           String   @db.VarChar(50)
  description    String   @db.Text
  reference      String   @unique @db.VarChar(100)
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(100)
  status         String   @default("completed") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model SubscriptionPlan {
  id                String   @id @default(uuid()) @db.VarChar(36)
  code              String   @unique @db.VarChar(50)
  nameEn            String   @map("name_en") @db.VarChar(100)
  nameRw            String   @map("name_rw") @db.VarChar(100)
  nameFr            String   @map("name_fr") @db.VarChar(100)
  descriptionEn     String?  @map("description_en") @db.Text
  descriptionRw     String?  @map("description_rw") @db.Text
  descriptionFr     String?  @map("description_fr") @db.Text
  priceMinor        BigInt   @default(0) @map("price_minor")
  currency          String   @default("RWF") @db.VarChar(10)
  durationDays      Int      @default(0) @map("duration_days")
  messagingLimit    Int      @default(-1) @map("messaging_limit")
  canUnlockContacts Boolean  @default(false) @map("can_unlock_contacts")
  isActive          Boolean  @default(true) @map("is_active")
  displayOrder      Int      @default(0) @map("display_order")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  planId    String   @map("plan_id") @db.VarChar(36)
  startedAt DateTime @default(now()) @map("started_at")
  expiresAt DateTime @map("expires_at")
  status    String   @default("active") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model PaymentAttempt {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @map("user_id") @db.VarChar(36)
  txRef         String   @unique @map("tx_ref") @db.VarChar(100)
  flwRef        String?  @map("flw_ref") @db.VarChar(100)
  amountMinor   BigInt   @map("amount_minor")
  currency      String   @default("RWF") @db.VarChar(10)
  status        String   @default("pending") @db.VarChar(50)
  paymentMethod String?  @map("payment_method") @db.VarChar(50)
  meta          Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id        String   @id @default(uuid()) @db.VarChar(36)
  eventId   String?  @unique @map("event_id") @db.VarChar(100)
  eventType String   @map("event_type") @db.VarChar(100)
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("payment_webhook_events")
}

model ContactUnlock {
  id              String   @id @default(uuid()) @db.VarChar(36)
  requesterId     String   @map("requester_id") @db.VarChar(36)
  targetUserId    String   @map("target_user_id") @db.VarChar(36)
  amountPaidMinor BigInt   @default(2000) @map("amount_paid_minor")
  currency        String   @default("RWF") @db.VarChar(10)
  consentGivenAt  DateTime @default(now()) @map("consent_given_at")
  createdAt       DateTime @default(now()) @map("created_at")

  requester  User @relation("RequestedUnlocks", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUser User @relation("TargetUnlocks", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetUserId], name: "unique_contact_unlock")
  @@map("contact_unlocks")
}

model Notification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  body      String   @db.Text
  linkUrl   String?  @map("link_url") @db.VarChar(255)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Block {
  blockerId String   @map("blocker_id") @db.VarChar(36)
  blockedId String   @map("blocked_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockerUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id             String   @id @default(uuid()) @db.VarChar(36)
  reporterId     String   @map("reporter_id") @db.VarChar(36)
  reportedUserId String   @map("reported_user_id") @db.VarChar(36)
  reason         String   @db.VarChar(100)
  details        String?  @db.Text
  status         String   @default("pending") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  reporter     User @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportedReports", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model ModerationEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  eventType   String   @map("event_type") @db.VarChar(100)
  rawContent  String?  @map("raw_content") @db.Text
  riskScore   Int?     @default(0) @map("risk_score")
  actionTaken String   @map("action_taken") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("moderation_events")
}

model AdminSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admin_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  adminId    String?  @map("admin_id") @db.VarChar(36)
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.VarChar(100)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
